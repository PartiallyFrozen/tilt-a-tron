# Doom's globals stay out of internal RAM, which is for Wi-Fi, DMA buffers and stacks.
#  - zero-initialised ones (visplanes, drawsegs, lookup tables: several hundred KB) go
#    in the PSRAM BSS segment;
#  - initialised ones (sound table, config lists, animation tables: 20 KB) go with the
#    read-only data. That works because CONFIG_SPIRAM_RODATA copies rodata into PSRAM
#    at boot, where it is ordinary writable memory. Without that option they would sit
#    in flash and the first write would fault, so keep the two together.
[sections:doom_bss]
entries:
    .bss+

[sections:doom_common]
entries:
    COMMON

[scheme:doom_extram_bss]
entries:
    doom_bss -> extern_ram
    doom_common -> extern_ram
    data -> flash_rodata

[mapping:doom]
archive: libdoom.a
entries:
    * (doom_extram_bss)
