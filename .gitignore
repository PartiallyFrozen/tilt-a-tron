# Generated by the build. sdkconfig is rebuilt from sdkconfig.defaults, which is the
# source of truth for every setting - keeping the generated copy out of git means a
# contributor's local tinkering never shows up as a diff.
build/
sdkconfig
sdkconfig.old
managed_components/
releases/*.bin

# .NET build output for the manager app
app/**/bin/
app/**/obj/
app/**/publish/
__pycache__/
tests/out/

# Backups pulled off a watch. Somebody's own themes and saves - their files, not this
# project's, and this repo is public.
backups/
