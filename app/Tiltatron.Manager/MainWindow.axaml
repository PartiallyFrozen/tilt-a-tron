<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Tiltatron.Manager.MainWindow"
        Title="Tilt-a-tron" Icon="/icon.ico"
        Width="760" Height="700" MinWidth="620" MinHeight="480">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18">

    <!-- Who we are talking to -->
    <Border Grid.Row="0" Classes="card">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="3">
          <TextBlock Classes="title" Text="TILT-A-TRON" />
          <TextBlock x:Name="StatusLine" Classes="dim" Text="Looking for a watch..." />
        </StackPanel>
        <Button Grid.Column="1" x:Name="ConnectButton" Content="Refresh" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- What you can do -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="InstallGameButton" Content="Install a game..." IsEnabled="False" />
      <Button x:Name="SendThemeButton" Content="Send a theme..." IsEnabled="False" />
      <Button x:Name="BackupButton" Content="Back up everything..." IsEnabled="False" />
      <Button x:Name="RemoveButton" Content="Remove" IsEnabled="False" />
    </StackPanel>

    <!-- What is on it -->
    <Border Grid.Row="2" Classes="card" Margin="0,12,0,0">
      <ScrollViewer>
        <StackPanel x:Name="ContentPanel" Spacing="14" />
      </ScrollViewer>
    </Border>

    <!-- What it is doing -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <ProgressBar Grid.Column="0" x:Name="Progress" Height="6" Minimum="0" Maximum="100"
                   Foreground="#28C86E" Background="#22252F" IsVisible="False" />
      <TextBlock Grid.Column="1" x:Name="BusyLine" Classes="dim" Margin="12,0,0,0" Text="" />
    </Grid>
  </Grid>
</Window>
